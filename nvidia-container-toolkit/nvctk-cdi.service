[Unit]
Description=nvidia-container-toolkit CDI auto-generation
ConditionFileIsExecutable=/usr/bin/nvidia-ctk
After=local-fs.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/bash -c 'for i in {1..60}; do if test -d /sys/module/nvidia && test -d /sys/module/nvidia_modeset && test -d /sys/module/nvidia_uvm && test -d /sys/module/nvidia_drm && /usr/bin/nvidia-smi -L >/dev/null 2>&1; then exit 0; fi; sleep 1; done; exit 1'
ExecStart=/usr/bin/nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml

LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/etc/cdi

[Install]
WantedBy=multi-user.target
